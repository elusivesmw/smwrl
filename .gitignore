# exclude tools
tools/*

## except patches
!tools/asar/
tools/asar/*
!tools/asar/patches/
!tools/asar/patches/*

## except uberasm/retry
!tools/uberasm/
tools/uberasm/*
!tools/uberasm/list.txt
!tools/uberasm/gamemode/
!tools/uberasm/gamemode/*
!tools/uberasm/level/
!tools/uberasm/level/*
!tools/uberasm/library/
!tools/uberasm/library/*
!tools/uberasm/retry_config
!tools/uberasm/retry_config/*
!tools/uberasm/rogue
!tools/uberasm/rogue/*

## except blocks
!tools/gps/
tools/gps/*
!tools/gps/list.txt
!tools/gps/blocks/
!tools/gps/blocks/*
tools/gps/blocks/template.asm
# and custom routines
!tools/gps/routines
tools/gps/routines/*
!tools/gps/routines/side_contact_check.asm
!tools/gps/routines/check_sprite_kicked_horiz_alt.asm

## except sprites
!tools/pixi/
tools/pixi/*
!tools/pixi/list.txt
!tools/pixi/sprites/
!tools/pixi/sprites/*
tools/pixi/sprites/_header.asm

## except build config 
!tools/build/
tools/build/*
!tools/build/config.json

# exclude sysLMRestore folder
sysLMRestore/

# exclude roms and executables
*.smc
*.exe